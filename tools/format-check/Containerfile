# The clean room of docs/format-check.md: compilers with their sanitizers, make and python3, nothing of
# seqlz. cleanroom.sh mounts the claude binary of the host, the room and an empty home directory.
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install --setopt=install_weak_deps=False gcc clang compiler-rt libasan libubsan make \
        python3 diffutils findutils file which vim-common procps-ng && dnf clean all
