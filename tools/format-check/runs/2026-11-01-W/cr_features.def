/* CR_FAM(id, name, count, items, section) -- items: "#k" numbers from k on, else labels split by '|'.
 * One family per line; FEATURES.md describes each. */
CR_FAM(LAYOUT, "layout", 2, "raw|coded", "Layout of a compressed block")
CR_FAM(CODE, "code", 9, "#0", "Layout of a compressed block")
CR_FAM(DELTA, "e/dt", 4, "e=0|dt=1|dt=2|dt=3", "Layout of a compressed block; Literals as deltas")
CR_FAM(W, "w", 8, "#5", "Layout of a compressed block")
CR_FAM(WMIN, "w vs smallest", 2, "smallest|larger", "Layout of a compressed block")
CR_FAM(STREAM, "stream", 3, "empty|pad 0 bits|pad 1-7 bits", "Layout of a compressed block; Coded literals")
CR_FAM(OWNSYM, "OWN symbol", 19, "#0", "A block's own literal table")
CR_FAM(OWNX, "own table", 9, "runs adjacent|code no literal uses|values after last code|pad 0 bits|pad 1-7 bits|codes=2|codes=3-15|codes=16-255|codes=256", "A block's own literal table")
CR_FAM(LITLEN, "literal code bits", 10, "#1", "Coded literals")
CR_FAM(DELTAP, "delta literal", 2, "p<x stored as is|p>=x delta", "Literals as deltas")
CR_FAM(DT3, "dt=3 last", 4, "last=1 (x=4)|last=2 (x=4)|last=3 (x=6)|last>=4 (x=last)", "Literals as deltas")
CR_FAM(NLIT, "n", 5, "1|2-15|16-255|256-4095|4096", "Layout of a compressed block")
CR_FAM(NSEQ, "matches", 6, "0|1|2-15|16-255|256-1022|1023", "Decoding")
CR_FAM(LASTLL, "last sequence", 3, "0 literals|1-3 literals|4+ literals", "Decoding")
CR_FAM(TOK, "token sent", 3, "with its code|escaped, has a code|escaped, has no code", "Tokens")
CR_FAM(LLF, "ll field", 16, "#0", "Tokens")
CR_FAM(MLF, "mlf", 32, "#0", "Tokens")
CR_FAM(CLASS, "class", 6, "#0", "Tokens; Offsets")
CR_FAM(LLSYM, "LL symbol", 24, "#0", "Length values")
CR_FAM(MLSYM, "ML symbol", 24, "#0", "Length values")
CR_FAM(OFF, "offset", 6, "class 0 in first sequence (1)|class>0 equal to last|off<ml (overlap)|off = bytes written (from byte 0)|off=1|match reaches block end", "Offsets; Decoding")
CR_FAM(BPAD, "B", 3, "empty|pad 0 bits|pad 1-7 bits", "The bitstream of the sequences")
/* Large families, printed as a summary: how many of the items occurred. They come last. */
CR_FAM(TOKV, "token (any way)", 3072, "#0", "Tokens")
CR_FAM(TOKC, "token sent with its code", 3072, "#0", "Tokens")
CR_FAM(LLV, "ll of a sequence with a match", 4096, "#0", "Tokens; Length values; Decoding")
CR_FAM(MLV, "ml", 4096, "#0", "Tokens; Length values; Decoding")
CR_FAM(OFFV2, "offset of class 2", 4096, "#0", "Offsets")
CR_FAM(OFFV3, "offset of class 3", 4096, "#0", "Offsets")
CR_FAM(OFFV4, "offset of class 4", 4096, "#0", "Offsets")
CR_FAM(OFFV5, "offset of class 5", 4096, "#0", "Offsets")
CR_FAM(LITV, "stored literal, 256 * code + value", 2304, "#0", "Coded literals")
CR_FAM(RAWV, "raw literal value", 256, "#0", "Layout of a compressed block")
